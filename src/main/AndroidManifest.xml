<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== LOCATION PERMISSIONS ==================== -->
    <!-- Required for network-based location services -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />



    <!-- ==================== FOREGROUND SERVICE PERMISSIONS ==================== -->
    <!-- Required for non-killable background service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Location-type FGS: required on API 34+ so GpsForegroundService (v3.8)
         can promote with the location service type and keep the GEV GPS feed
         running with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Mic-type FGS: required on API 34+ so speech capture can run while the
         screen is locked (watch push-to-talk). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- PARTIAL_WAKE_LOCK held for the duration of a voice capture. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ==================== MICROPHONE PERMISSION ==================== -->
    <!-- Required for speech-to-text recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ==================== NETWORK PERMISSIONS ==================== -->
    <!-- Required for WireGuard tunnel communication and WiFi state detection -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- ==================== MEDIA BUTTON PERMISSIONS ==================== -->
    <!-- Required for receiving media button events from wearables (Garmin watch PTT) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    
    <!-- ==================== BOOT PERMISSION ==================== -->
    <!-- Required to restart service after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ==================== HARDWARE FEATURES ==================== -->
    <!-- Declare required hardware features -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeRoam"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- ==================== MAIN ACTIVITY ==================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FreeRoam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ==================== BACKGROUND SERVICE ==================== -->
        <!-- TacticalBackgroundService runs as a foreground service -->
        <service
            android:name=".service.TacticalBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- ==================== CLIPBOARD MONITOR SERVICE ==================== -->
        <!-- Service for clipboard-to-Kokoro TTS integration (X17 laptop Control+S equivalent) -->
        <!-- ==================== CLIPBOARD MONITOR SERVICE ==================== -->
        <!-- Service for clipboard-to-Kokoro TTS integration (X17 laptop Control+S equivalent) -->
        <service
            android:name=".service.ClipboardMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ==================== GEV GPS FOREGROUND SERVICE ==================== -->
        <!-- Location-type FGS (v3.8): owns GpsReporter so the operator position
             feed (POST /api/gps on the Burst Receiver :8083) keeps running with
             the screen locked or the app backgrounded. Promoted from
             MainActivity.onStart()/permission-grant while the app is foregrounded
             with while-in-use location, which on API 30+ authorizes background
             location continuation — no ACCESS_BACKGROUND_LOCATION prompt needed.
        -->
        <service
            android:name=".service.GpsForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>