<?xml version="1.0" encoding="utf-8"?>
<!-- LGI "you" bubble — QSS QLabel#you: deep-dim base, faint accent border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lgi_deep_dim" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/lgi_border_faint" />
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp" />
</shape>